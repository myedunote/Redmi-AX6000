# ============================================================
# 核心插件矩阵（由 customize 脚本追加到 .config）
# 适用：ImmortalWrt 24.10 / 25.12、LEDE、237
# ============================================================

# 主题与中文
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh-cn=y

# 1) 网络代理：HomeProxy
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_ucode-mod-math=y

# 2) 穿透 / 反向代理：Lucky（源码在 customize 中克隆）
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# 3) 零信任组网：Tailscale
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# 4) DNS 过滤：AdGuard Home
# 24.10 / 237 的 luci feed 没有 luci-app-adguardhome，defconfig 会自动忽略这一行
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# 体积控制
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
# CONFIG_PACKAGE_man is not set
# CONFIG_PACKAGE_doc is not set
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_perl is not set

# 关闭与矩阵重复的重型代理，避免体积翻倍
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-daed is not set